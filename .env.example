# ScamBuster — server co may chu (deploy Render / Railway)
# Ban dung de chay local + deploy len host ngoai, thay cho ban tinh Netlify
# (ban tinh chi luu tai khoan theo may, khong xem duoc tat ca nguoi choi).

PORT=3000
# Thu muc luu database SQLite (Render free: du lieu chi ton tai den khi redeploy;
# muon giu lau dai thi dat DATABASE_URL de dung Neon Postgres — xem README).
DATA_DIR=./data
# STORE=sqlite (mac dinh, dung node:sqlite co san tu Node 22) hoac STORE=json
# (du phong khi host dung Node cu hon, luu dang file JSON).
# STORE=sqlite
# DATABASE_URL — chuoi ket noi Neon Postgres (free, khong het han 90 ngay).
# Co bien nay thi server dung Postgres va du lieu KHONG mat khi redeploy.
# KHONG ghi chuoi that vao file nay / khong day len Git — chi dat trong
# Render Dashboard > Environment. Vi du dang (khong phai chuoi that):
# DATABASE_URL=postgres://user:pass@ep-xxx-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
